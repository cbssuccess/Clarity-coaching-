{
  "manifest_version": 3,
  "name": "Clarity Coaching",
  "short_name": "Clarity Coaching",
  "version": "1.0.0",
  "description": "Daily clarity prompts and quick access to your coaching journey - for the what now moment.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clarity Coaching"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  }
}
