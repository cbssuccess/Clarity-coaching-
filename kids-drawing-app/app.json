{
  "expo": {
    "name": "Doodle Kids",
    "slug": "doodle-kids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF9E6"
    },
    "ios": {
      "bundleIdentifier": "com.doodlekids.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Doodle Kids saves your drawings to your photo library.",
        "NSPhotoLibraryUsageDescription": "Doodle Kids needs access to save your drawings."
      }
    },
    "android": {
      "package": "com.doodlekids.app",
      "permissions": ["WRITE_EXTERNAL_STORAGE", "READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "backgroundColor": "#FFF9E6",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Doodle Kids saves your drawings to your photo library.",
          "savePhotosPermission": "Allow Doodle Kids to save drawings.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
